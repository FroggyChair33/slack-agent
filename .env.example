AGENT_NAME=stephen
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Local checkout of the SHARED PROJECT repo this agent works in - must be a
# git clone with 'origin' set and push access (gh must be installed and
# logged in: `gh auth login`). Each task runs here, then gets committed to
# a new branch and PR'd against AGENT_BASE_BRANCH.
AGENT_WORKDIR=C:\path\to\your\project\checkout
AGENT_BASE_BRANCH=main

# "coder" (writes code, opens PRs, never merges) or "reviewer" (reviews/
# merges existing PRs). See roles/coder.md and roles/reviewer.md - the
# reviewer role needs a much more permissive AGENT_SANDBOX_MODE below to
# actually run `gh pr merge`; read roles/reviewer.md before setting that.
AGENT_ROLE=coder

# How the reviewer role pings the orchestrator when something needs its
# attention (issues found during review/merge, or an infra-level failure).
# Only matters when AGENT_ROLE=reviewer.
INSTINCT_MENTION=@Instinct

# "claude" (Claude Code) or "codex" (OpenAI Codex CLI). Changes which
# command runner.py builds - see README "Agent kinds".
AGENT_KIND=claude
# Binary name/path; defaults to AGENT_KIND's name (claude or codex).
AGENT_BIN=claude
# How much the agent can do without asking:
#   claude: default | acceptEdits | bypassPermissions
#   codex:  read-only | workspace-write | danger-full-access
# Defaults to acceptEdits for claude, workspace-write for codex.
AGENT_SANDBOX_MODE=acceptEdits
TASK_TIMEOUT_SECONDS=1800
